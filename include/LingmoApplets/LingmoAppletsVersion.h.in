#pragma once

#define LINGMOAPPLETS_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define LINGMOAPPLETS_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define LINGMOAPPLETS_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define LINGMOAPPLETS_VERSION "@PROJECT_VERSION@"

#define LINGMOAPPLETS_VERSION_CHECK(major, minor, patch) \
    ((major) * 10000 + (minor) * 100 + (patch))

#define LINGMOAPPLETS_VERSION_NUMBER \
    LINGMOAPPLETS_VERSION_CHECK( \
        LINGMOAPPLETS_VERSION_MAJOR, \
        LINGMOAPPLETS_VERSION_MINOR, \
        LINGMOAPPLETS_VERSION_PATCH)
